{
  "name": "@sshk/upload-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "sshk-tools 应用级上传能力：本地/远程(ftp|sftp)/云存储 Provider 抽象、校验、并发与重试",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/upload-types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sshk/shared": "workspace:*",
    "@aws-sdk/client-s3": "latest",
    "@azure/storage-blob": "latest",
    "ali-oss": "latest",
    "basic-ftp": "latest",
    "bce-sdk-js": "latest",
    "cos-nodejs-sdk-v5": "latest",
    "esdk-obs-nodejs": "latest",
    "p-limit": "latest",
    "qiniu": "latest",
    "ssh2": "latest"
  },
  "devDependencies": {
    "@types/ali-oss": "latest",
    "@types/ssh2": "latest",
    "typescript": "6",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
