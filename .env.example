# sshk-tools 环境变量模板：复制为 .env 后按需取消注释（.env 已 gitignore，勿提交）
# 加载时机：主进程启动最先加载（src/main/env-load.ts）；pnpm release 等根目录脚本同样加载。
# dotenv 规则：真实环境变量优先于 .env；修改 .env 后需重启对应进程。
#
# ── 环境变量契约（scripts/check-env.mjs 在 pnpm verify 中强制校验）──────────────
# 本文件是环境变量的唯一真相源，双向一致才算通过：
#   · 源码读取的键必须在此声明      → 读而未声明 = 臆造 / 拼写错误
#   · 此声明的键必须被源码读取      → 声明而未读 = 僵尸 env（配了也不生效，最易误导开发者）
# 由外部工具直接读取、不经过本项目源码的变量，行尾显式写 `# @external <工具名>` 豁免；
# 不写豁免理由的一律判为僵尸。新增 / 删除 env 必须同时改源码与本文件，缺一即门禁失败。
# 框架/平台注入（NODE_ENV / CI / NO_COLOR / ELECTRON_RENDERER_URL）由脚本白名单放行，无需声明。
# ────────────────────────────────────────────────────────────────────────────

# ── 网络 / TLS（公司网络 TLS 中间人拦截时启用；release 打包子进程默认已带这两个值）──
# NODE_USE_SYSTEM_CA=1
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Electron / 打包镜像（下载慢或被墙时启用；scripts/build-local.mjs 与 ensure-electron.mjs 均支持覆盖默认值）──
# ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
# ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/

# ── 代码签名（证书到位后填写，流程见 docs/05-release/代码签名证书获取与配置.md）──
# 以下变量由 electron-builder / @electron/osx-sign 通过 electron-builder.yml 的 ${env.XXX} 直接读取，本项目源码不读
# WIN_CSC_FILE=                    # @external electron-builder
# WIN_CSC_KEY_PASSWORD=           # @external electron-builder
# APPLE_ID=                       # @external electron-builder
# APPLE_APP_SPECIFIC_PASSWORD=    # @external electron-builder
# APPLE_TEAM_ID=                  # @external electron-builder

# ── GitHub Release（设置了则可用 electron-builder --publish always 自动建 Release）──
# GH_TOKEN=

# ── 官方工具包签名（scripts/sign-tool.mjs）──
# 私钥只放本机环境变量 / CI Secret，绝不写入任何文件
# SSHK_OFFICIAL_SIGNING_KEY=    # Ed25519 私钥 PEM（pkcs8），签名 .sshktool 时读取；未设置则拒绝签名
# SSHK_ROTATE_SIGNING_KEY=1     # 设为 1 时现场生成新密钥对并打印公钥，供登记 packages/shared/src/trust.ts
