# sshk-tools 环境变量模板：复制为 .env 后按需取消注释（.env 已 gitignore，勿提交）
# dotenv 规则：真实环境变量优先于 .env；修改 .env 后需重启对应进程 / 重新构建。
#
# ══ 命名分组（看前缀就知道改哪里、什么场景生效）══════════════════════════
#   SSHK_DEV_*     仅 dev（pnpm dev）生效；构建版绝不生效、不烤入应用
#   SSHK_BUILD_*   仅构建 / 打包阶段由脚本读取，不进应用
#   SSHK_APP_*     构建期烤入应用（主进程 __SSHK_BAKED_ENV__）；默认禁止本机同名
#                  env 覆盖，仅 SSHK_APP_OVERRIDABLE 显式列出的键可被覆盖
#   其余无前缀键   第三方工具 / Node 固定名，仅构建阶段，改名无效
#
# ══ 契约（scripts/check-env.mjs 在 pnpm verify 强制校验）═════════════════
#   · 源码读取的键必须在此声明（读而未声明 = 臆造 / 拼错）
#   · 此声明的键必须被源码读取（声明而未读 = 僵尸 env）
#   · 外部工具直接读取的键，声明行尾写 `# @external <工具名>` 豁免
#   · 框架注入（NODE_ENV / CI / NO_COLOR / ELECTRON_RENDERER_URL）脚本白名单放行
# ═══════════════════════════════════════════════════════════════════════════

# ── 一、构建镜像 / 网络（外部键 · 仅打包脚本读，不进应用）──────────────────

# ELECTRON_MIRROR — Electron 下载镜像（下载慢或被墙时设置）
#   可选值：任意镜像 URL；未设置：脚本兜底 npmmirror
# ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# ELECTRON_BUILDER_BINARIES_MIRROR — electron-builder 二进制镜像
#   可选值：任意镜像 URL；未设置：脚本兜底 npmmirror
# ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/

# NODE_USE_SYSTEM_CA — 信任系统 CA（公司网络 TLS 中间人拦截时启用）
#   可选值：1（启用）/ 其它（Node 默认）；未设置：Node 自带 CA；release 打包子进程已默认带 1
# NODE_USE_SYSTEM_CA=1

# NODE_TLS_REJECT_UNAUTHORIZED — 放行自签证书（仅调试用）
#   可选值：0（放行）/ 其它（拒绝）；未设置：拒绝非法证书；release 打包子进程已默认带 0
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── 二、Electron 下载旋钮（外部键 · ensure-electron.mjs 读 · 一般无需设置）──

# ELECTRON_INSTALL_PLATFORM — 强制 Electron 下载平台
#   可选值：win32 / darwin / linux；未设置：当前平台
# ELECTRON_INSTALL_PLATFORM=

# ELECTRON_INSTALL_ARCH — 强制 Electron 下载架构
#   可选值：x64 / arm64 / ia32；未设置：当前架构
# ELECTRON_INSTALL_ARCH=

# ELECTRON_USE_REMOTE_CHECKSUMS — Electron 校验和来源
#   可选值：1（远端 checksums）/ 其它（内置清单）；未设置：用 electron 包内置清单
# ELECTRON_USE_REMOTE_CHECKSUMS=1

# ELECTRON_CONFIG_CACHE — Electron 下载缓存目录
#   可选值：任意目录；未设置：%LOCALAPPDATA%/electron/Cache
# ELECTRON_CONFIG_CACHE=

# ELECTRON_FORCE_NO_CACHE — 忽略缓存强制重新下载
#   可选值：true（强制重下）/ 其它（用缓存）；未设置：优先缓存
# ELECTRON_FORCE_NO_CACHE=true

# ── 三、代码签名 / 发布（外部键 + SSHK_BUILD_* · 仅发布流水线）────────────

# WIN_CSC_FILE — Windows 代码签名证书文件
#   可选值：证书路径；未设置：不签名
# WIN_CSC_FILE=                    # @external electron-builder

# WIN_CSC_KEY_PASSWORD — Windows 证书密码
#   未设置：签名失败（配 WIN_CSC_FILE 使用）
# WIN_CSC_KEY_PASSWORD=            # @external electron-builder

# APPLE_ID — mac 公证 Apple 账号
#   未设置：不做 mac 公证
# APPLE_ID=                        # @external electron-builder

# APPLE_APP_SPECIFIC_PASSWORD — mac 公证专用密码
#   未设置：mac 公证失败（配 APPLE_ID 使用）
# APPLE_APP_SPECIFIC_PASSWORD=     # @external electron-builder

# APPLE_TEAM_ID — mac 公证团队 ID
#   未设置：mac 公证失败（配 APPLE_ID 使用）
# APPLE_TEAM_ID=                   # @external electron-builder

# GH_TOKEN — GitHub 令牌
#   可选值：GitHub PAT；未设置：--publish always 不生效（不自动建 Release）
# GH_TOKEN=                        # @external electron-builder

# SSHK_BUILD_SIGNING_KEY — 官方工具包签名私钥（Ed25519 PEM pkcs8，优先级最高）
#   未设置：读本机 ~/.sshk/official-signing-key.pem（pnpm keys:init 生成 / 导入）；
#   CI Secret / 临时注入用；换设备见 docs/05-release/官方签名密钥跨设备开发.md
# SSHK_BUILD_SIGNING_KEY=

# SSHK_BUILD_SIGNING_ROTATE — 轮换官方签名密钥对
#   可选值：1（轮换）/ 其它（不轮换）；未设置：不轮换；=1 时生成新密钥对、落盘新私钥并打印公钥供登记
# SSHK_BUILD_SIGNING_ROTATE=1

# ── 四、打包裁剪（SSHK_BUILD_* · 仅构建期，electron.vite.config 读取）──────

# SSHK_BUILD_TOOLS — 打包内建工具白名单（依赖闭包自动补齐，未选工具不进包）
#   可选值：工具 id 逗号分隔（如 model-console,badge-studio）/ all / *；
#   未设置：全量打包（各工具按可见性配置展示）
# SSHK_BUILD_TOOLS=

# ── 五、应用行为（SSHK_APP_* · 构建期烤入主进程，dev / 打包版共用）────────
#   覆盖规则：默认禁止本机同名 env 覆盖；仅 SSHK_APP_OVERRIDABLE 显式列出的键可覆盖

# SSHK_APP_DEVTOOLS_KEY — 打开开发者工具 / 开发者模式的访问密钥（明文，主进程 sha256 比对）
#   可选值：任意字符串；未设置：内置 sshk-tools@888；settings.json 显式哈希优先级更高
# SSHK_APP_DEVTOOLS_KEY=

# SSHK_APP_AUTO_UPDATE — 分发包自动更新总开关
#   可选值：0 / false（禁用）/ 其它（开启）；未设置：开启
#   禁用时顶栏无更新入口、更新流程完全不走（内网 / 定制分发）
# SSHK_APP_AUTO_UPDATE=0

# SSHK_APP_OVERRIDABLE — 烤入键的覆盖白名单（逗号分隔键名）
#   可选值：允许被本机同名 env 覆盖的 SSHK_ 键列表（如 SSHK_APP_DEVTOOLS_KEY）；
#   未设置：全部锁死；白名单自身永远锁死（只有 .env 能改，防本机给自己授权）
# SSHK_APP_OVERRIDABLE=

# ── 六、dev 调试（SSHK_DEV_* · 仅 pnpm dev，构建版绝不生效）──────────────

# SSHK_DEV_UPDATE_TEST — 走真实 GitHub 更新源测试完整更新流程（下载线上新版但不自动安装）
#   可选值：1 / true（开启）/ 其它（关闭）；未设置：关闭
# SSHK_DEV_UPDATE_TEST=1

# SSHK_DEV_UPDATE_FAKE_VERSION — 伪装 app.getVersion() 复现「发现新版」（配 SSHK_DEV_UPDATE_TEST）
#   可选值：任意版本号；未设置：读 package.json 真实版本
# SSHK_DEV_UPDATE_FAKE_VERSION=1.0.0

# SSHK_DEV_UPDATE_MIRROR — dev 更新测试的下载镜像前缀（国内直连 GitHub 下载常挂起导致进度恒 0%）
#   用途：更新源（latest.yml + 安装包）改走 `镜像前缀/原始URL` 透传（如 ghfast.top），下载可正常出进度
#   可选值：任意镜像站前缀（不含尾斜杠，如 https://ghfast.top）；未设置：走原生 GitHub 直连
#   定义：读 dev-app-update.yml 的 owner/repo 拼 `<mirror>/https://github.com/<owner>/<repo>/releases/latest/download`
# SSHK_DEV_UPDATE_MIRROR=
# SSHK_DEV_UPDATE_KEEP_CACHE — dev 更新测试保留 updater 下载缓存（不清 pending）
#   用途：默认每次「检查更新」前清 pending 缓存使安装包重新下载，便于反复观察下载进度；
#         设 1 保留缓存，复用已下载安装包（测「已下载秒装」分支）
#   可选值：1 / true（保留缓存）/ 其它（清缓存）；未设置：清缓存
# SSHK_DEV_UPDATE_KEEP_CACHE=1

# SSHK_DEV_APP_PROTOCOL — dev 渲染层加载协议
#   可选值：1（app://）/ 其它（dev server http）；未设置：http；
#   打包版始终走 app://，不受此开关控制
# SSHK_DEV_APP_PROTOCOL=1
