{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@sshk/shared": ["./packages/shared/src/index.ts"],
      "@sshk/shared/tool-skeleton": ["./packages/shared/src/tool-skeleton/index.ts"],
      "@sshk/upload-core/types": ["./packages/upload-core/src/upload-types.ts"],
      "@sshk/share-core/ui": ["./packages/share-core/src/ui/index.ts"],
      "@sshk/form-schema/ui": ["./packages/form-schema/src/ui/index.ts"],
      "@main/*": ["./apps/desktop/src/main/*"],
      "@renderer/*": ["./apps/desktop/src/renderer/*"],
      "@app/*": ["./apps/desktop/src/*"],
      "@build/*": ["./apps/desktop/build/*"],
      "@sshk/rich-text/pure": ["./packages/rich-text/src/pure.ts"],
      "@sshk/code-editor/format": ["./packages/code-editor/src/format.ts"],
      "@sshk/repository": ["./packages/repository/src/index.ts"],
      "@sshk/backup": ["./packages/backup/src/index.ts"],
      "@sshk/ui-kit": ["./packages/ui-kit/src/index.ts"],
      "@sshk/*": ["./packages/*/src/index.ts", "./tools/*/src/index.ts"],
      "electron": ["./apps/desktop/node_modules/electron/electron.d.ts"],
      "electron-updater": ["./apps/desktop/node_modules/electron-updater/out/main.d.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "out", ".tmp", ".git"]
}
