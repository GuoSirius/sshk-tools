{
  "name": "sshk-tools",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "公司内部本地工具集合桌面客户端（Electron 应用 + 工具包）",
  "scripts": {
    "dev": "pnpm --filter @sshk/desktop dev",
    "build": "pnpm --filter @sshk/desktop build",
    "start": "pnpm --filter @sshk/desktop preview",
    "dist": "node scripts/build-local.mjs",
    "pack": "node scripts/build-local.mjs --dir",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:preload": "node scripts/check-preload.mjs",
    "check:dialogs": "node scripts/check-dialogs.mjs",
    "check:contract": "node scripts/check-package-contract.mjs",
    "check:latest": "node scripts/check-latest.mjs",
    "check:signature": "node scripts/check-signature.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:external": "node scripts/build-external.mjs --check",
    "build:external": "node scripts/build-external.mjs",
    "keys:init": "node scripts/init-signing-key.mjs",
    "check:structure": "node scripts/verify-structure.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "verify": "pnpm check:structure && pnpm check:boundaries && pnpm check:preload && pnpm check:dialogs && pnpm check:contract && pnpm check:latest && pnpm check:signature && pnpm check:external && pnpm check:env && pnpm typecheck && pnpm typecheck:vue && pnpm lint && pnpm test",
    "typecheck:vue": "node scripts/run-vue-tsc.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/node": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "husky": "latest",
    "typescript": "6",
    "vitest": "latest",
    "vue-tsc": "latest",
    "@inquirer/prompts": "latest",
    "dotenv": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
