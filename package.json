{
  "name": "sshk-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "公司内部本地工具集合桌面客户端（Electron 应用 + 工具包）",
  "scripts": {
    "dev": "pnpm --filter @sshk/desktop dev",
    "build": "pnpm --filter @sshk/desktop build",
    "start": "pnpm --filter @sshk/desktop preview",
    "pack": "pnpm --filter @sshk/desktop build && pnpm --filter @sshk/desktop exec electron-builder --dir",
    "dist": "pnpm --filter @sshk/desktop build && pnpm --filter @sshk/desktop exec electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:latest": "node scripts/check-latest.mjs",
    "check:structure": "node scripts/verify-structure.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "verify": "pnpm check:structure && pnpm check:boundaries && pnpm check:latest && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/node": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "husky": "latest",
    "typescript": "6",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24"
  }
}
