{
  "id": "badge-studio",
  "name": "Badge Studio",
  "description": "上传点击统计与邮件 HTML，注入 badge 并生成海报长图；支持图片/截图识别为点击数据",
  "category": [
    "邮件营销",
    "数据分析"
  ],
  "tags": [
    "海报生成"
  ],
  "icon": "auto",
  "entryRoute": "generate",
  "enabled": true,
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "main": "src/main/index.ts",
    "renderer": "src/renderer/BadgeStudioPage.vue",
    "channels": [
      "badge:generate",
      "badge:regenerate",
      "badge:parseDatasource",
      "badge:readHtml",
      "badge:markBadges",
      "badge:savePosterPng",
      "badge:listPosters",
      "badge:deletePoster",
      "badge:savePosterMeta",
      "badge:exportFiles",
      "badge:downloadPng",
      "badge:shareResolve",
      "badge:parseImage",
      "badge:setVisionKey",
      "badge:visionState"
    ]
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    {
      "id": "generate",
      "label": "生成海报"
    },
    {
      "id": "posters",
      "label": "海报列表"
    },
    {
      "id": "config",
      "label": "工具配置"
    }
  ],
  "configGroups": [
    {
      "id": "config-badge",
      "label": "角标",
      "fields": [
        {
          "key": "badgeAttr",
          "label": "badge 属性",
          "type": "string",
          "hint": "注入到 HTML 的自定义属性名"
        },
        {
          "key": "badgePositionText",
          "label": "文本链接默认位置",
          "type": "select",
          "options": [
            {
              "label": "左上",
              "value": "top-left"
            },
            {
              "label": "上中",
              "value": "top-center"
            },
            {
              "label": "右上",
              "value": "top-right"
            },
            {
              "label": "左中",
              "value": "left-center"
            },
            {
              "label": "居中",
              "value": "center"
            },
            {
              "label": "右中",
              "value": "right-center"
            },
            {
              "label": "左下",
              "value": "bottom-left"
            },
            {
              "label": "下中",
              "value": "bottom-center"
            },
            {
              "label": "右下",
              "value": "bottom-right"
            }
          ],
          "hint": "未手写 data-badge-position 的文本类 <a> 的角标位置"
        },
        {
          "key": "badgePositionImage",
          "label": "图片链接默认位置",
          "type": "select",
          "options": [
            {
              "label": "左上",
              "value": "top-left"
            },
            {
              "label": "上中",
              "value": "top-center"
            },
            {
              "label": "右上",
              "value": "top-right"
            },
            {
              "label": "左中",
              "value": "left-center"
            },
            {
              "label": "居中",
              "value": "center"
            },
            {
              "label": "右中",
              "value": "right-center"
            },
            {
              "label": "左下",
              "value": "bottom-left"
            },
            {
              "label": "下中",
              "value": "bottom-center"
            },
            {
              "label": "右下",
              "value": "bottom-right"
            }
          ],
          "hint": "带 <img> 的 <a> 的角标位置；<a> 上手写的 data-badge-position 优先级最高"
        },
        {
          "key": "clicksField",
          "label": "角标数值列",
          "type": "string",
          "hint": "clicks / totalClicks，或表格里任意自定义数值列名"
        },
        {
          "key": "posterWidth",
          "label": "海报宽度",
          "type": "number",
          "min": 320,
          "max": 1600
        },
        {
          "key": "scale",
          "label": "截图像素比",
          "type": "number",
          "min": 1,
          "max": 4
        }
      ]
    },
    {
      "id": "config-url",
      "label": "URL 归一",
      "fields": [
        {
          "key": "urlNorm.stripUtm",
          "label": "去 UTM 参数",
          "type": "boolean"
        },
        {
          "key": "urlNorm.stripHash",
          "label": "去 hash",
          "type": "boolean"
        },
        {
          "key": "urlNorm.stripTrailingSlash",
          "label": "去末尾斜杠",
          "type": "boolean"
        },
        {
          "key": "urlNorm.sortQuery",
          "label": "查询参数排序",
          "type": "boolean"
        },
        {
          "key": "urlNorm.lowercaseHost",
          "label": "域名小写",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "config-badge-style",
      "label": "角标样式覆盖",
      "preview": "badge-css",
      "fields": [
        {
          "key": "badgeStyleCss.common",
          "label": "公共样式",
          "type": "textarea",
          "codeEditor": true,
          "full": true,
          "hint": "所有位置共享；后于内置默认生效"
        },
        {
          "key": "badgeStyleCss.positions.topLeft",
          "label": "左上",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.topCenter",
          "label": "上中",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.topRight",
          "label": "右上",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.leftCenter",
          "label": "左中",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.center",
          "label": "居中",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.rightCenter",
          "label": "右中",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.bottomLeft",
          "label": "左下",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.bottomCenter",
          "label": "下中",
          "type": "textarea",
          "codeEditor": true
        },
        {
          "key": "badgeStyleCss.positions.bottomRight",
          "label": "右下",
          "type": "textarea",
          "codeEditor": true
        }
      ]
    },
    {
      "id": "config-poster",
      "label": "海报",
      "fields": [
        {
          "key": "commonHtmlDir",
          "label": "常用 HTML 目录",
          "type": "dir",
          "hint": "留空则不启用"
        },
        {
          "key": "posterDir",
          "label": "海报产物目录",
          "type": "dir",
          "hint": "导出默认落盘目录；留空则每次手动选择"
        }
      ]
    },
    {
      "id": "config-upload",
      "label": "上传通道",
      "fields": [
        {
          "key": "upload.targetType",
          "label": "目标类型",
          "type": "select",
          "options": [
            { "value": "local", "label": "本地目录" },
            { "value": "remote", "label": "远程" },
            { "value": "cloud", "label": "云存储" }
          ],
          "hint": "与 EDM Studio 共用应用级「上传配置」里的全局 profile"
        },
        {
          "key": "upload.profileId",
          "label": "全局配置",
          "type": "select",
          "optionsSource": "upload:all",
          "hint": "留空则使用该类型的默认 profile"
        },
        {
          "key": "upload.overrides.localDir",
          "label": "本地目录覆盖",
          "type": "dir",
          "hint": "仅目标类型=本地目录时生效"
        },
        {
          "key": "upload.overrides.prefix",
          "label": "对象前缀",
          "type": "string",
          "hint": "云存储对象 key 前缀，如 badge/"
        }
      ]
    }
  ],
  "defaults": {
    "upload": {
      "targetType": "local",
      "profileId": "",
      "overrides": {},
      "validation": {}
    },
    "enabled": true,
    "requiredGrant": "",
    "dependsOn": [],
    "badgeAttr": "data-edm-badge",
    "badgePositionText": "top-right",
    "badgePositionImage": "center",
    "badgeStyle": {
      "background": "#e60012",
      "color": "#fff",
      "size": 18,
      "offsetY": 0,
      "offsetX": 0
    },
    "clicksField": "clicks",
    "badgeStyleCss": {
      "common": "",
      "positions": {}
    },
    "urlNorm": {
      "stripUtm": true,
      "stripHash": true,
      "stripTrailingSlash": true,
      "sortQuery": true,
      "lowercaseHost": true
    },
    "posterWidth": 680,
    "scale": 2,
    "recentHtmls": [],
    "commonHtmlDir": null,
    "posterDir": null,
    "vision": {
      "provider": "cloud",
      "providerId": "",
      "modelOverride": "",
      "paddleCommand": "python",
      "paddleArgs": "{image}"
    },
    "ocrLayout": {
      "linkNumberSameLine": true,
      "thousandsSeparator": true,
      "skipTotalRow": true,
      "skipKeywords": "合计,总计,小计,total,sum",
      "columnOrder": "url,clicks,totalClicks"
    }
  },
  "visibility": "desktop",
  "package": {
    "schemaVersion": 1,
    "version": "1.0.0",
    "requiresHost": {
      "api": "^1.0",
      "capabilities": []
    },
    "sandbox": "utility",
    "ipcAllowlist": []
  }
}
