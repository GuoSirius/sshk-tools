{
  "id": "model-console",
  "name": "Model Console",
  "description": "配置本地 / 云 / 自部署模型，连接测试与对话调试",
  "category": "AI 能力",
  "tags": ["模型网关"],
  "icon": "auto",
  "entryRoute": "providers",
  "enabled": true,
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "renderer": "src/renderer/ModelConsolePage.vue",
    "channels": []
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    { "id": "providers", "label": "模型 Provider" },
    { "id": "chat", "label": "对话调试" },
    { "id": "config", "label": "工具配置" }
  ],
  "configGroups": [
    {
      "id": "config-gateway",
      "label": "网关",
      "fields": [
        { "key": "defaultProviderId", "label": "默认 Provider", "type": "string", "hint": "填 Provider ID；留空由应用配置决定" },
        { "key": "chatTimeoutMs", "label": "请求超时(ms)", "type": "number", "min": 1000, "max": 120000 },
        { "key": "streamEnabled", "label": "启用流式输出", "type": "boolean" }
      ]
    }
  ],
  "defaults": {
    "enabled": true,
    "requiredGrant": "",
    "dependsOn": [],
    "defaultProviderId": "",
    "chatTimeoutMs": 30000,
    "streamEnabled": true
  }
}
