{
  "id": "model-console",
  "name": "Model Console",
  "description": "配置本地 / 云 / 自部署模型，连接测试与对话调试",
  "category": "AI 能力",
  "tags": [
    "模型网关"
  ],
  "icon": "auto",
  "entryRoute": "providers",
  "enabled": true,
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "renderer": "src/renderer/ModelConsolePage.vue",
    "channels": [],
    "main": ""
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    {
      "id": "providers",
      "label": "模型 Provider"
    },
    {
      "id": "chat",
      "label": "对话调试"
    },
    {
      "id": "config",
      "label": "工具配置"
    }
  ],
  "configGroups": [
    {
      "id": "config-gateway",
      "label": "网关",
      "fields": [
        {
          "key": "defaultProviderId",
          "label": "默认 Provider",
          "type": "string",
          "devOnly": true,
          "fallbackKey": "app.llm.activeProviderId",
          "hint": "留空则用应用当前激活的 Provider（下方展示其生效值）"
        },
        {
          "key": "chatTimeoutMs",
          "label": "请求超时(ms)",
          "type": "number",
          "min": 1000,
          "max": 120000
        },
        {
          "key": "streamEnabled",
          "label": "启用流式输出",
          "type": "boolean"
        }
      ]
    }
  ],
  "defaults": {
    "enabled": true,
    "requiredGrant": "",
    "dependsOn": [],
    "defaultProviderId": "",
    "chatTimeoutMs": 30000,
    "streamEnabled": true,
    "defaultProviders": [
      {
        "_id": "prv_agnesai",
        "name": "Agnes AI",
        "kind": "remote",
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "model": "agnes-3.0-flash",
        "enabled": true
      }
    ],
    "modelPresets": [
      {
        "id": "agnes",
        "name": "Agnes AI",
        "baseURL": "https://apihub.agnes-ai.com/v1",
        "kind": "remote",
        "defaultModel": "agnes-3.0-flash",
        "models": [
          "agnes-3.0-flash",
          "agnes-3.0-pro"
        ],
        "hint": "填 API Key 即可；模型名可点「拉取模型列表」实时查询"
      },
      {
        "id": "openai",
        "name": "OpenAI",
        "baseURL": "https://api.openai.com/v1",
        "kind": "remote",
        "defaultModel": "gpt-4o-mini",
        "models": [
          "gpt-4o-mini",
          "gpt-4o",
          "gpt-3.5-turbo"
        ],
        "hint": "官方 /v1 端点"
      },
      {
        "id": "deepseek",
        "name": "DeepSeek",
        "baseURL": "https://api.deepseek.com/v1",
        "kind": "remote",
        "defaultModel": "deepseek-chat",
        "models": [
          "deepseek-chat",
          "deepseek-reasoner"
        ],
        "hint": "OpenAI 兼容端点"
      },
      {
        "id": "dashscope",
        "name": "通义千问（兼容模式）",
        "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "kind": "remote",
        "defaultModel": "qwen-plus",
        "models": [
          "qwen-plus",
          "qwen-turbo",
          "qwen-max"
        ],
        "hint": "阿里云百炼 OpenAI 兼容模式"
      },
      {
        "id": "zhipu",
        "name": "智谱 GLM",
        "baseURL": "https://open.bigmodel.cn/api/paas/v4",
        "kind": "remote",
        "defaultModel": "glm-4-flash",
        "models": [
          "glm-4-flash",
          "glm-4-air",
          "glm-4"
        ],
        "hint": "OpenAI 兼容端点"
      },
      {
        "id": "ollama",
        "name": "本地 Ollama",
        "baseURL": "http://127.0.0.1:11434/v1",
        "kind": "local",
        "defaultModel": "qwen2.5:7b",
        "models": [
          "qwen2.5:7b",
          "llama3.1:8b"
        ],
        "hint": "本机推理无需 API Key；模型列表由本机 /models 真实返回"
      },
      {
        "id": "vllm",
        "name": "自部署 vLLM / LM Studio",
        "baseURL": "http://127.0.0.1:8000/v1",
        "kind": "local",
        "defaultModel": "",
        "models": [],
        "hint": "留空模型名，保存前点「拉取模型列表」自动获取"
      }
    ]
  },
  "visibility": "desktop",
  "package": {
    "schemaVersion": 1,
    "version": "1.0.0",
    "requiresHost": {
      "api": "^1.0",
      "capabilities": []
    },
    "sandbox": "utility",
    "ipcAllowlist": []
  }
}
