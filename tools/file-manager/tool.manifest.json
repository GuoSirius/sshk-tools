{
  "id": "file-manager",
  "name": "文件管理",
  "description": "文件系统（本地/远端/云存储浏览管理 + 上传下载传输队列）与应用级上传通道配置；密钥经 safeStorage 加密，不下发渲染层。",
  "category": "系统能力",
  "tags": [
    "文件系统",
    "上传",
    "安全存储"
  ],
  "icon": "auto",
  "entryRoute": "files",
  "enabled": true,
  "visibility": "desktop",
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "main": "",
    "renderer": "src/renderer/FileManagerPage.vue",
    "channels": []
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    {
      "id": "files",
      "label": "文件系统",
      "icon": "M3 7V5a2 2 0 012-2h4l2 2h8a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7zM3 7h18"
    },
    {
      "id": "contents",
      "label": "内容管理",
      "icon": "M4 4h16v16H4zM8 9h8M8 13h8M8 17h5"
    },
    {
      "id": "profiles",
      "label": "通道配置",
      "icon": "M12 15V4M8 8l4-4 4 4M4 20h16"
    },
    {
      "id": "config",
      "label": "工具设置",
      "icon": "M12 8a4 4 0 100 8 4 4 0 000-8zm8.4 3.1l2-.6-1-3.4-2 .6a8 8 0 00-1.2-1.2l.6-2-3.4-1-.6 2a8 8 0 00-1.7 0l-.6-2-3.4 1 .6 2a8 8 0 00-1.2 1.2l-2-.6-1 3.4 2 .6a8 8 0 000 1.7l-2 .6 1 3.4 2-.6c.4.4.8.8 1.2 1.2l-.6 2 3.4 1 .6-2a8 8 0 001.7 0l.6 2 3.4-1-.6-2c.4-.4.8-.8 1.2-1.2l2 .6 1-3.4-2-.6a8 8 0 000-1.7z"
    }
  ],
  "configGroups": [
    {
      "id": "content-editor",
      "label": "内容编辑器",
      "fields": [
        {
          "key": "editorMode",
          "label": "新建/编辑形式",
          "type": "select",
          "options": [
            {
              "label": "弹框",
              "value": "dialog"
            },
            {
              "label": "整页",
              "value": "page"
            }
          ],
          "hint": "内容管理的新建/编辑容器形态（弹框=弹窗、整页=整页视图），两种形态共用同一编辑器实现；保存后下次打开生效",
          "full": true,
          "default": "dialog"
        }
      ]
    },
    {
      "id": "fs-transfer",
      "label": "传输与分片",
      "fields": [
        {
          "key": "app.fs.multipart.thresholdMb",
          "label": "分片阈值 (MB)",
          "type": "number",
          "min": 1,
          "max": 1024,
          "default": 50,
          "hint": "上传/下载超过该大小的文件走分片 + 断点续传（1~1024，默认 50）；由文件系统传输与图片库上传（FilePicker）共用同一份配置",
          "full": true
        },
        {
          "key": "app.fs.multipart.partSizeMb",
          "label": "单片大小 (MB)",
          "type": "number",
          "min": 5,
          "max": 100,
          "default": 5,
          "hint": "每个分片的大小（5~100，默认 5）；分片数超上限时自动上调单片大小",
          "full": true
        },
        {
          "key": "app.fs.multipart.partsConcurrency",
          "label": "分片并发数",
          "type": "number",
          "min": 1,
          "max": 8,
          "default": 3,
          "hint": "单任务同时传输的分片数（1~8，默认 3）",
          "full": true
        },
        {
          "key": "app.fs.multipart.requestTimeoutSec",
          "label": "请求超时 (秒)",
          "type": "number",
          "min": 30,
          "max": 3600,
          "default": 300,
          "hint": "云上传/下载单请求超时（30~3600 秒，默认 300）；弱网或大文件 ACK 慢可调大。超时后自动复核服务端是否已落盘，已落盘不会误报失败",
          "full": true
        }
      ]
    }
  ],
  "defaults": {},
  "package": {
    "schemaVersion": 1,
    "version": "1.0.0",
    "requiresHost": {
      "api": "^1.0",
      "capabilities": []
    },
    "sandbox": "utility",
    "ipcAllowlist": []
  }
}