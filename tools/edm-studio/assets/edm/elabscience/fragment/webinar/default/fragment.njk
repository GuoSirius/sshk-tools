<link rel="stylesheet" href="@system/css/reset.css">
<link rel="stylesheet" href="@root/elabscience/css/standard-default.css">
<link rel="stylesheet" href="./css/webinar.css">

<tr>
  <td colspan="4" class="image-box">
    {% if banner_link %}
      <a href="{{ banner_link }}">
        <img src="{{ banner_image }}" />
      </a>
    {% endif %}

    {% if not banner_link %}
      <img src="{{ banner_image }}" />
    {% endif %}
  </td>
</tr>

<tr>
  <td colspan="4" class="h-[24px]"></td>
</tr>

<tr>
  <td></td>
  <td colspan="2">
    <table cellspacing="0" cellpadding="0" border="0">
      <colgroup>
        <col />
      </colgroup>

      <tbody>
        <tr>
          <td>{{ banner_keywords }}</td>
        </tr>

        {% for it0 in banner_moreKeywords %}
          <tr>
            <td class="h-[12px]"></td>
          </tr>

          <tr>
            <td>{{ it0 }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </td>
  <td></td>
</tr>

<tr>
  <td colspan="4" class="h-[24px]"></td>
</tr>

<tr>
  <td></td>
  <td colspan="2" class="bg-gray pb-[16px]">
    <table cellspacing="0" cellpadding="0" border="0">
      <colgroup>
        <col />
      </colgroup>

      <tbody class="align-middle">
        <tr>
          <td class="bg-white p-[8px_16px_0]">
            <span class="title {{ introduction_className }}">{{ introduction_title }}</span>
          </td>
        </tr>

        <tr>
          <td class="h-[12px]"></td>
        </tr>

        <tr>
          <td class="px-[16px]">
            {% for it1 in introduction_lists %}
              <p class="pb-[5px] {{ introduction_itemClassName }}">{{ it1 | safe }}</p>
            {% endfor %}
          </td>
        </tr>

        {% if introduction_buttonText %}
          <tr>
            <td class="text-right pt-[18px] pr-[16px]">
              <a {% if introduction_buttonLink %}href="{{ introduction_buttonLink }}"{% endif %} class="button-linear-orange font-bold decoration-none">{{ introduction_buttonText }}</a>
            </td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </td>
  <td></td>
</tr>

<tr>
  <td colspan="4" class="h-[24px]"></td>
</tr>

<tr>
  <td></td>
  <td colspan="2" class="bg-gray pb-[16px]">
    <table cellspacing="0" cellpadding="0" border="0">
      <colgroup>
        <col />
      </colgroup>

      <tbody class="align-middle">
        <tr>
          <td class="bg-white p-[8px_16px_0]">
            <span class="title {{ reserve_className }}">{{ reserve_title }}</span>
          </td>
        </tr>

        <tr>
          <td class="h-[12px]"></td>
        </tr>

        <tr>
          <td class="px-[16px]">
            {% for it2 in reserve_lists %}
              <p class="pb-[5px] {{ reserve_itemClassName }}">{{ it2 }}</p>
            {% endfor %}
            <p class="pb-[5px] calendar {{ reserve_itemClassName }}"><strong>{{ reserve_weekDate }}</strong></p>
            <p class="pb-[5px] {{ reserve_itemClassName }}"><span class="clock inline-block w-[18px] h-[24px] -mb-[3px]"></span>{{ reserve_time }}</p>
          </td>
        </tr>

        {% if reserve_buttonText %}
          <tr>
            <td class="text-right pt-[18px] pr-[16px]">
              <a {% if reserve_buttonLink %}href="{{ reserve_buttonLink }}"{% endif %} class="button-linear-orange font-bold decoration-none">{{ reserve_buttonText }}</a>
            </td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </td>
  <td></td>
</tr>

{% if gift %}
  <tr>
    <td colspan="4" class="h-[24px]"></td>
  </tr>

  <tr>
    <td></td>
    <td colspan="2">
      <p class="color-blue gift">{{ gift }}</p>
    </td>
    <td></td>
  </tr>
{% endif %}

<tr>
  <td colspan="4" class="h-[24px]"></td>
</tr>

<tr>
  <td></td>
  <td colspan="2">
    <table cellspacing="0" cellpadding="0" border="0">
      <colgroup>
        <col width="25%" />
        <col />
      </colgroup>

      <tbody class="align-top">
        <tr>
          <td rowspan="2" class="image-box pr-[12px]">
            <img src="{{ speaker_avatar }}" />
          </td>
          <td class="h-[0px] pb-[24px]">
            <p><strong class="text-size-[27px] font-bold mr-[20px]">Speaker</strong> {{ speaker_username }}</p>
            <p>{{ speaker_jobTitle }}</p>
          </td>
        </tr>

        <tr>
          <td>
            <p class="pb-[3px]">Limited seats available. <a {% if speaker_registerLink %}href="{{ speaker_registerLink }}"{% endif %} class="finger color-blue">Register in 30 seconds</a></p>
            <p>Questions? {% if speaker_email %}<a href="mailto:{{ speaker_email }}" class="color-blue">{{ speaker_email }}</a>{% endif %}</p>
          </td>
        </tr>
      </tbody>
    </table>
  </td>
  <td></td>
</tr>
