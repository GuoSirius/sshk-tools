<link rel="stylesheet" href="@system/css/reset.css"/>
<link rel="stylesheet" href="@root/elabscience/css/standard-default.css"/>
<link rel="stylesheet" href="./css/webinar.css"/>
<table cellspacing="0" cellpadding="0" border="0">
  <colgroup>
    <col width="{{ template.leftGap | default('10px', true) }}"/>
    <col/> <col/> <col width="{{ template.rightGap | default('10px', true) }}"/>
  </colgroup>
  <tbody>
    <tr>
      <td colspan="4" class="image-box">
        {% if bannerLink %}
          <a href="{{ bannerLink }}" class="w-full">
            <img src="{{ bannerImage }}" class="w-full"/>
          </a>
        {% endif %}
        {% if not bannerLink %}
          <img src="{{ bannerImage }}" class="w-full"/>
        {% endif %}
      </td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0">
          <colgroup>
            <col/>
          </colgroup>
          <tbody>
            {% for it0 in abstractInformation %}
              {% if not loop.first %}
                <tr>
                  <td class="h-[12px]"></td>
                </tr>
              {% endif %}
              <tr>
                <td>{{ it0.value | safe }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2" class="bg-gray pb-[16px]">
        <table cellspacing="0" cellpadding="0" border="0">
          <colgroup>
            <col/>
          </colgroup>
          <tbody class="align-middle">
            <tr>
              <td class="bg-white p-[8px_16px_0]">
                <span class="title {{ introductionTitleClassName }}">{{ introductionTitle }}</span>
              </td>
            </tr>
            <tr>
              <td class="h-[12px]"></td>
            </tr>
            <tr>
              <td class="px-[16px]">
                {% for it1 in introductionLists %}
                  <p class="pb-[5px] {{ introductionItemClassName | default('') }}">{{ it1.value | safe }}</p>
                {% endfor %}
              </td>
            </tr>
            {% if introductionButtonText %}
              <tr>
                <td class="text-right pt-[18px] pr-[16px]">
                  <a {% if introductionButtonLink %} href="{{ introductionButtonLink }}" {% endif %} class="button-linear-orange font-bold decoration-none">{{ introductionButtonText }}</a>
                </td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2" class="bg-gray pb-[16px]">
        <table cellspacing="0" cellpadding="0" border="0">
          <colgroup>
            <col/>
          </colgroup>
          <tbody class="align-middle">
            <tr>
              <td class="bg-white p-[8px_16px_0]">
                <span class="title {{ reserveTitleClassName }}">{{ reserveTitle }}</span>
              </td>
            </tr>
            <tr>
              <td class="h-[12px]"></td>
            </tr>
            <tr>
              <td class="px-[16px]">
                {% for it2 in reserveLists %}
                  <p class="pb-[5px] {{ reserveItemClassName | default('') }}">{{ it2.value }}</p>
                {% endfor %}
                <p class="pb-[5px] calendar {{ reserveItemClassName | default('') }}">
                  <strong>{{ reserveDate }}</strong>
                </p>
                <p class="pb-[5px] {{ reserveItemClassName | default('') }}">
                  <span class="clock inline-block w-[18px] h-[24px] -mb-[3px]"></span>
                  {{ reserveTime }}</p>
              </td>
            </tr>
            {% if reserveButtonText %}
              <tr>
                <td class="text-right pt-[18px] pr-[16px]">
                  <a {% if reserveButtonLink %} href="{{ reserveButtonLink }}" {% endif %} class="button-linear-orange font-bold decoration-none">{{ reserveButtonText }}</a>
                </td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    {% if goodNews %}
      <tr>
        <td colspan="4" class="h-[24px]"></td>
      </tr>
      <tr>
        <td></td>
        <td colspan="2">
          <p class="color-blue gift">{{ goodNews }}</p>
        </td>
        <td></td>
      </tr>
    {% endif %}
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0">
          <colgroup>
            <col width="25%"/>
          <col/>
          </colgroup>
          <tbody class="align-top">
            <tr>
              <td rowspan="2" class="image-box pr-[12px]">
                <img src="{{ speakerAvatar }}"/>
              </td>
              <td class="h-[0px] pb-[24px]">
                <p>
                  <strong class="text-size-[27px] font-bold mr-[20px]">Speaker</strong>
                  {{ speakerUsername }}</p>
                <p>{{ speakerJobTitle }}</p>
              </td>
            </tr>
            <tr>
              <td>
                <p class="pb-[3px]">Limited seats available.
                  <a {% if registerLink %} href="{{ registerLink }}" {% endif %} class="finger color-blue">Register in 30 seconds</a>
                </p>
                <p>Questions?
                  {% if questionEmail %}
                    <a href="mailto:{{ questionEmail }}" class="color-blue">{{ questionEmail }}</a>
                  {% endif %}
                </p>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
  </tbody>
</table>
