<link rel="stylesheet" href="@system/css/reset.css"/>
<link rel="stylesheet" href="@root/elabscience/css/standard-default.css"/>
<link rel="stylesheet" href="./css/new-arrivals.css"/>
<table cellspacing="0" cellpadding="0" border="0">
  <colgroup>
    <col width="{{ template.leftGap | default('10px', true) }}"/>
    <col/> <col/> <col width="{{ template.rightGap | default('10px', true) }}"/>
  </colgroup>
  <tbody>
    <tr>
      <td colspan="4" class="image-box">
        {% if bannerLink %}
          <a href="{{ bannerLink }}" class="w-full">
            <img src="{{ bannerImage }}" class="w-full"/>
          </a>
        {% endif %}
        {% if not bannerLink %}
          <img src="{{ bannerImage }}" class="w-full"/>
        {% endif %}
      </td>
    </tr>
    <tr>
      <td colspan="4" class="h-[16px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">{{ abstractInformation | safe }}</td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td colspan="4">
        <table cellspacing="0" cellpadding="0" border="0" class="bg-light-primary">
          <colgroup>
            <col width="{{ template.leftGap | default('10px', true) }}"/>
            <col/> <col width="{{ template.rightGap | default('10px', true) }}"/>
          </colgroup>
          <tbody>
            <tr>
              <td></td>
              <td class="pt-[3px]">
                <span class="{{ wordCloudTitleClassName }}">{{ wordCloudTitle }}</span>
              </td>
              <td></td>
            </tr>
            {% if not wordCloudNeedCondensed %}
              <tr>
                <td colspan="3" class="h-[12px]"></td>
              </tr>
            {% endif %}
            <tr>
              <td></td>
              <td class="pb-[5px] {% if not wordCloudNeedCondensed %}px-[6px]{% endif %}">
                {% for it0 in wordCloudLists %}
                  <span class="word-cloud-item">
                    <a class="cursor-default" style="color: {{ it0.color }}" {% if it0.link %} href="{{ it0.link }}" {% endif %}>{{ it0.text }}</a>
                  </span>
                {% endfor %}
              </td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0">
          <colgroup>
            <col/>
          </colgroup>
          <tbody class="align-middle">
            <tr>
              <td>
                <span class="{{ advantageTitleClassName }}">{{ advantageTitle }}</span>
              </td>
            </tr>
            <tr>
              <td class="h-[12px]"></td>
            </tr>
            <tr>
              <td>
                {% for it1 in advantageLists %}
                  <p class="pb-[5px] {{ advantageItemClassName }} color-primary">{{ it1.value | safe }}</p>
                {% endfor %}
              </td>
            </tr>
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0">
          <colgroup>
            <col/>
          </colgroup>
          <tbody class="align-middle">
            <tr>
              <td>
                <span class="{{ indicatorTitleClassName }}">{{ indicatorTitle }}</span>
              </td>
            </tr>
            <tr>
              <td class="h-[12px]"></td>
            </tr>
            <tr>
              <td>
                {% for it2 in indicatorLists %}
                  <p class="pb-[5px] {{ indicatorItemClassName }} color-primary">{{ it2.value | safe }}</p>
                {% endfor %}
              </td>
            </tr>
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    {% if perRowCount is not defined or perRowCount <= 1 %}
      <tr>
        <td colspan="4" class="h-[16px]"></td>
      </tr>
    {% endif %}
    <tr>
      <td></td>
      <td colspan="2">
        {% if perRowCount is defined and perRowCount > 1 %}
          {# 网格：每行 perRowCount 个产品，单元格内纵向排图/名/按钮 #}
          <table cellspacing="0" cellpadding="0" border="0" class="text-center">
            <colgroup>
              {% for i in range(0, perRowCount) %}
                <col/>
              {% endfor %}
            </colgroup>
            <tbody>
              {% for row in productLists | batch(perRowCount) %}
                <tr>
                  {% for it3 in row %}
                    {% if it3 %}
                      <td class="pt-[24px]">
                        <p class="image-box"><img src="{{ it3.image }}" alt="{{ it3.name }}"/>
                        </p>
                        <p class="pt-[8px]">{{ it3.name }}</p>
                        <p class="pt-[12px]">
                          <a href="{{ it3.link }}" class="button font-bold decoration-none rounded-[16px] inline-block">{{ it3.buttonText }}</a>
                        </p>
                      </td>
                    {% endif %}
                  {% endfor %}
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          {# 平铺：所有产品同一行，三行分别为图/名/按钮 #}
          <table cellspacing="0" cellpadding="0" border="0" class="text-center">
            <colgroup>
              {% for it4 in productLists %}
                <col {% if it4.width %} width="it4.width" {% endif %}/>
              {% endfor %}
            </colgroup>
            <tbody>
              <tr>
                {% for it5 in productLists %}
                  <td class="image-box">
                    <img src="{{ it5.image }}" alt="{{ it5.name }}"/>
                  </td>
                {% endfor %}
              </tr>
              <tr>
                {% for it6 in productLists %}
                  <td>{{ it6.name }}</td>
                {% endfor %}
              </tr>
              <tr>
                {% for it7 in productLists %}
                  <td class="pt-[8px]">
                    <a href="{{ it7.link }}" class="button font-bold decoration-none rounded-[16px]">{{ it7.buttonText }}</a>
                  </td>
                {% endfor %}
              </tr>
            </tbody>
          </table>
        {% endif %}
      </td>
      <td></td>
    </tr>
  </tbody>
</table>
