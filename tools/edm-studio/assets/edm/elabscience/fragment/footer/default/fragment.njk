<link rel="stylesheet" href="@system/css/reset.css"/>
<link rel="stylesheet" href="@root/elabscience/css/standard-default.css"/>
<link rel="stylesheet" href="@root/elabscience/template/standard/default/css/template.css"/>
<link rel="stylesheet" href="./css/footer.css"/>
<table cellspacing="0" cellpadding="0" border="0">
  <colgroup>
    <col width="{{ template.leftGap | default('10px', true) }}"/>
    <col/> <col/> <col width="{{ template.rightGap | default('10px', true) }}"/>
  </colgroup>
  <tbody>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0" class="text-center">
          <colgroup><col width="20%"/><col/> <col/><col/><col/><col/><col/><col width="20%"/></colgroup>
          <tbody>
            <tr>
              <td></td>
              <td colspan="6" class="font-bold text-size-[14px] pb-[5px]">Connect with us</td>
              <td></td>
            </tr>
            <tr>
              <td></td>
              {% for s in socials %}
                <td class="text-size-0">
                  <a href="{{ s.href }}" class="image-box"><img src="{{ s.icon }}" alt="{{ s.label }}"/>
                  </a>
                </td>
              {% endfor %}
              <td></td>
            </tr>
            <tr>
              <td></td>
              <td colspan="6" class="pt-[8px] border-b border-b-dashed border-b-[#828282]"></td>
              <td></td>
            </tr>
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[24px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0" class="contact-us text-center align-middle">
          <tbody>
            <tr>
              <td>
                <strong>{{ companyName }}</strong>
              </td>
            </tr>
            <tr>
              <td>
                <img src="{{ phoneIcon }}" alt="" class="align-middle"/>
                <span class="align-middle">Toll-free:
                  <a href="tel:{{ phoneHref }}" class="decoration-none">{{ phone }}</a>
                </span>
              </td>
            </tr>
            <tr>
              <td>
                <img src="{{ siteIcon }}" alt="" class="align-middle"/>
                <span class="align-middle">Web:
                  <a href="{{ webHref }}" class="decoration-none">{{ web }}</a>
                </span>
              </td>
            </tr>
            <tr>
              <td>
                <img src="{{ mailIcon }}" alt="" class="align-middle"/>
                <span class="align-middle">Email:
                  {% for e in emails %}
                    <a href="mailto:{{ e.href }}" class="decoration-none edm-mail-link {% if not loop.last %}pl-[10px]{% endif %}">{{ e.label }}</a>
                    {% if not loop.last %};{% endif %}
                  {% endfor %}
                </span>
              </td>
            </tr>
            <tr>
              <td>
                {{ address }}
              </td>
            </tr>
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[32px]"></td>
    </tr>
  </tbody>
</table></tr></tbody>
