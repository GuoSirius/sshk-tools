<link rel="stylesheet" href="@system/css/reset.css"/>
<link rel="stylesheet" href="@root/elabscience/css/standard-default.css"/>
<link rel="stylesheet" href="./css/header.css"/>
<table cellspacing="0" cellpadding="0" border="0">
  <colgroup>
    <col width="{{ template.leftGap | default('10px', true) }}"/>
    <col/> <col/> <col width="{{ template.rightGap | default('10px', true) }}"/>
  </colgroup>
  <tbody>
    <tr>
      <td colspan="4">
        <a href="{{ logoLink }}" class="image-box">
          <img src="{{ logoImage }}" alt="{{ logoAlt }}" class="w-full"/>
        </a>
      </td>
    </tr>
    <tr>
      <td colspan="4" class="h-[16px]"></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0" class="text-center table-auto w-full">
          <tbody>
            <tr>
              {% for item in navLinks %}
                <td>
                  <a href="{{ item.link }}" class="decoration-none color-[#006DB8]">{{ item.name }}</a>
                </td>
              {% endfor %}
            </tr>
          </tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr>
      <td colspan="4" class="h-[16px]"></td>
    </tr>
  </tbody>
</table>
