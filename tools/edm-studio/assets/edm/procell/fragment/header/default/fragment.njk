<link rel="stylesheet" href="@shared/email-utils.css">
<link rel="stylesheet" href="@root/procell/css/palette.css">
<link rel="stylesheet" href="@root/procell/css/components.css">
<link rel="stylesheet" href="@root/procell/template/standard/css/template.css">
<link rel="stylesheet" href="./css/header.css">

<table cellspacing="0" cellpadding="0" border="0" class="header edm-header">
  <colgroup><col width="10px" /><col /><col /><col width="10px" /></colgroup>
  <tbody>
    <tr>
      <td colspan="4" class="banner image-box">
        <a href="{{ logoLink }}"><img src="{{ logoImage }}" alt="{{ logoAlt }}" /></a>
      </td>
    </tr>
    <tr><td colspan="4" class="h-16"></td></tr>
    <tr>
      <td></td>
      <td colspan="2">
        <table cellspacing="0" cellpadding="0" border="0" class="navigation text-center table-auto">
          <tbody><tr>
            {% for item in navLinks %}
            <td><a href="{{ item.href }}" class="decoration-none edm-nav-link">{{ item.label }}</a></td>
            {% endfor %}
          </tr></tbody>
        </table>
      </td>
      <td></td>
    </tr>
    <tr><td colspan="4" class="h-16"></td></tr>
  </tbody>
</table>
