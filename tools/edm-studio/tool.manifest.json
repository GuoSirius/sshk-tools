{
  "id": "edm-studio",
  "name": "EDM Studio",
  "description": "制作邮件 EDM：品牌 / 模板 / 片段 / 版本、数据填充与三阶段 HTML 生成",
  "category": "邮件营销",
  "tags": [
    "内容生产",
    "HTML 生成"
  ],
  "icon": "auto",
  "entryRoute": "mails",
  "enabled": true,
  "visibility": "desktop",
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "main": "src/main/index.ts",
    "renderer": "src/renderer/EdmStudioPage.vue",
    "channels": [
      "edm:api"
    ]
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    {
      "id": "mails",
      "label": "邮件管理"
    },
    {
      "id": "content",
      "label": "内容管理"
    },
    {
      "id": "config",
      "label": "工具配置"
    }
  ],
  "configGroups": [
    {
      "id": "config-ai",
      "label": "AI 助手",
      "fields": [
        {
          "key": "ai.providerId",
          "label": "Provider",
          "type": "select",
          "optionsSource": "llm:providers",
          "fallbackKey": "app.llm.activeProviderId",
          "hint": "AI 填充 / AI 润色使用的模型 Provider；默认跟随应用激活的 Provider，也可为本工具单独指定"
        },
        {
          "key": "ai.model",
          "label": "模型覆盖",
          "type": "select",
          "optionsSource": "llm:providerModels",
          "optionsDep": "ai.providerId",
          "hint": "留空 = 使用 Provider 配置的模型；下拉选择（「刷新」拉取最新模型列表）或手动输入（如 deepseek-chat / gpt-4o-mini）"
        }
      ]
    },
    {
      "id": "config-render",
      "label": "渲染",
      "fields": [
        {
          "key": "render.strict",
          "label": "严格模式",
          "type": "boolean",
          "hint": "未定义变量直接报错"
        },
        {
          "key": "render.autoEscape",
          "label": "HTML 转义",
          "type": "boolean",
          "hint": "防数据注入"
        }
      ]
    },
    {
      "id": "config-export",
      "label": "导出",
      "fields": [
        {
          "key": "export.defaultFileName",
          "label": "默认文件名",
          "type": "string",
          "hint": "生成 EDM 时使用的文件名"
        },
        {
          "key": "export.openAfterGenerate",
          "label": "生成后打开",
          "type": "boolean"
        }
      ]
    }
  ],
  "defaults": {
    "enabled": true,
    "requiredGrant": "",
    "dependsOn": [],
    "render": {
      "strict": true,
      "autoEscape": true
    },
    "ai": {
      "providerId": "",
      "model": ""
    },
    "export": {
      "defaultStages": [
        "final"
      ],
      "defaultFileName": "edm.html",
      "openAfterGenerate": false
    }
  },
  "package": {
    "schemaVersion": 1,
    "version": "1.0.0",
    "requiresHost": {
      "api": "^1.0",
      "capabilities": []
    },
    "sandbox": "utility",
    "ipcAllowlist": []
  }
}
