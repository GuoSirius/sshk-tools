{
  "id": "edm-studio",
  "name": "EDM Studio",
  "description": "制作邮件 EDM：品牌 / 模板 / 片段 / 版本、数据填充与三阶段 HTML 生成",
  "category": "邮件营销",
  "tags": [
    "内容生产",
    "HTML 生成"
  ],
  "icon": "auto",
  "entryRoute": "mails",
  "enabled": true,
  "visibility": "desktop",
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "main": "src/main/index.ts",
    "renderer": "src/renderer/EdmStudioPage.vue",
    "channels": [
      "edm:api",
      "edm:listMails",
      "edm:generate",
      "edm:regenerate"
    ]
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    {
      "id": "mails",
      "label": "邮件管理"
    },
    {
      "id": "content",
      "label": "内容管理"
    },
    {
      "id": "config",
      "label": "工具配置"
    }
  ],
  "configGroups": [
    {
      "id": "config-render",
      "label": "渲染",
      "fields": [
        {
          "key": "render.strict",
          "label": "严格模式",
          "type": "boolean",
          "hint": "未定义变量直接报错"
        },
        {
          "key": "render.autoEscape",
          "label": "HTML 转义",
          "type": "boolean",
          "hint": "防数据注入"
        }
      ]
    },
    {
      "id": "config-export",
      "label": "导出",
      "fields": [
        {
          "key": "export.defaultFileName",
          "label": "默认文件名",
          "type": "string",
          "hint": "生成 EDM 时使用的文件名"
        },
        {
          "key": "export.openAfterGenerate",
          "label": "生成后打开",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "config-upload",
      "label": "上传通道",
      "fields": [
        {
          "key": "upload.targetType",
          "label": "目标类型",
          "type": "select",
          "options": [
            { "value": "local", "label": "本地目录" },
            { "value": "remote", "label": "远程（FTP / SFTP）" },
            { "value": "cloud", "label": "云存储" }
          ],
          "hint": "连接信息在「上传配置」工具里统一预设，这里只选目标"
        },
        {
          "key": "upload.profileId",
          "label": "全局配置",
          "type": "select",
          "optionsSource": "upload:all",
          "hint": "留空则使用该类型的默认 profile；下拉来自应用级上传配置"
        },
        {
          "key": "upload.overrides.localDir",
          "label": "本地目录覆盖",
          "type": "dir",
          "hint": "目标类型=本地目录时生效，留空沿用全局默认目录"
        },
        {
          "key": "upload.overrides.remoteFolder",
          "label": "远端位置覆盖",
          "type": "string",
          "hint": "如 /2026/campaign；远端服务器上的位置，不是本机目录"
        },
        {
          "key": "upload.overrides.bucket",
          "label": "Bucket 覆盖",
          "type": "string",
          "hint": "云存储时可选覆盖"
        },
        {
          "key": "upload.overrides.prefix",
          "label": "对象前缀",
          "type": "string",
          "hint": "如 mail/，云存储对象 key 前缀"
        },
        {
          "key": "upload.validation.accept",
          "label": "允许扩展名",
          "type": "string",
          "hint": "逗号分隔，如 .png,.jpg；只能比全局更严，不能放宽"
        },
        {
          "key": "upload.validation.maxSize",
          "label": "大小上限(字节)",
          "type": "number",
          "min": 0,
          "max": 104857600,
          "hint": "0 = 沿用全局上限；工具只能设得更小"
        }
      ]
    }
  ],
  "defaults": {
    "enabled": true,
    "requiredGrant": "",
    "dependsOn": [],
    "render": {
      "strict": true,
      "autoEscape": true
    },
    "export": {
      "defaultStages": [
        "final"
      ],
      "defaultFileName": "edm.html",
      "openAfterGenerate": false
    },
    "upload": {
      "targetType": "local",
      "profileId": "",
      "overrides": {},
      "validation": {}
    }
  },
  "package": {
    "schemaVersion": 1,
    "version": "1.0.0",
    "requiresHost": {
      "api": "^1.0",
      "capabilities": []
    },
    "sandbox": "utility",
    "ipcAllowlist": []
  }
}
