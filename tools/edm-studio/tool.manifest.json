{
  "id": "edm-studio",
  "name": "EDM Studio",
  "description": "制作邮件 EDM：品牌 / 模板 / 片段 / 版本、数据填充与三阶段 HTML 生成",
  "category": "邮件营销",
  "tags": [
    "内容生产",
    "HTML 生成"
  ],
  "icon": "auto",
  "entryRoute": "mails",
  "enabled": true,
  "visibility": "desktop",
  "configLayout": "single",
  "plugin": {
    "source": "builtin",
    "main": "src/main/index.ts",
    "renderer": "src/renderer/EdmStudioPage.vue",
    "channels": [
      "edm:api",
      "edm:listMails",
      "edm:generate",
      "edm:regenerate"
    ]
  },
  "dependsOn": [],
  "configDeps": [],
  "requiredGrant": "",
  "menus": [
    {
      "id": "mails",
      "label": "邮件管理"
    },
    {
      "id": "content",
      "label": "内容管理"
    },
    {
      "id": "config",
      "label": "工具配置"
    }
  ],
  "configGroups": [
    {
      "id": "config-render",
      "label": "渲染",
      "fields": [
        {
          "key": "render.strict",
          "label": "严格模式",
          "type": "boolean",
          "hint": "未定义变量直接报错"
        },
        {
          "key": "render.autoEscape",
          "label": "HTML 转义",
          "type": "boolean",
          "hint": "防数据注入"
        }
      ]
    },
    {
      "id": "config-export",
      "label": "导出",
      "fields": [
        {
          "key": "export.defaultFileName",
          "label": "默认文件名",
          "type": "string",
          "hint": "生成 EDM 时使用的文件名"
        },
        {
          "key": "export.openAfterGenerate",
          "label": "生成后打开",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "config-upload",
      "label": "本地上传",
      "fields": [
        {
          "key": "upload.mode",
          "label": "上传方式",
          "type": "select",
          "options": [
            { "value": "local", "label": "本地目录" },
            { "value": "ftp", "label": "FTP" },
            { "value": "sftp", "label": "SFTP" }
          ],
          "hint": "生成产物推送到哪里"
        },
        {
          "key": "upload.localDir",
          "label": "本地目录",
          "type": "dir",
          "hint": "mode=本地目录时生效，生成文件落盘位置"
        },
        {
          "key": "upload.host",
          "label": "主机地址",
          "type": "string",
          "hint": "FTP/SFTP 主机，如 192.168.1.10"
        },
        {
          "key": "upload.port",
          "label": "端口",
          "type": "number",
          "min": 1,
          "max": 65535,
          "hint": "FTP 默认 21，SFTP 默认 22"
        },
        {
          "key": "upload.username",
          "label": "用户名",
          "type": "string"
        },
        {
          "key": "upload.password",
          "label": "密码",
          "type": "string",
          "hint": "敏感信息，建议配合密钥托管"
        },
        {
          "key": "upload.remoteDir",
          "label": "远程目录",
          "type": "string",
          "hint": "FTP/SFTP 根目录，如 /edm/out"
        },
        {
          "key": "upload.timeoutMs",
          "label": "超时(ms)",
          "type": "number",
          "min": 1000,
          "max": 60000,
          "hint": "单次上传超时"
        }
      ]
    },
    {
      "id": "config-cloud",
      "label": "云配置",
      "fields": [
        {
          "key": "cloud.provider",
          "label": "云厂商",
          "type": "select",
          "options": [
            { "value": "aliyun-oss", "label": "阿里云 OSS" },
            { "value": "tencent-cos", "label": "腾讯云 COS" },
            { "value": "aws-s3", "label": "AWS S3" },
            { "value": "qiniu", "label": "七牛 Kodo" }
          ],
          "hint": "生成产物发布的对象存储"
        },
        {
          "key": "cloud.region",
          "label": "地域",
          "type": "string",
          "hint": "如 oss-cn-hangzhou / ap-guangzhou"
        },
        {
          "key": "cloud.endpoint",
          "label": "Endpoint",
          "type": "string",
          "hint": "如 oss-cn-hangzhou.aliyuncs.com"
        },
        {
          "key": "cloud.bucket",
          "label": "Bucket",
          "type": "string"
        },
        {
          "key": "cloud.accessKeyId",
          "label": "AccessKey ID",
          "type": "string"
        },
        {
          "key": "cloud.accessKeySecret",
          "label": "AccessKey Secret",
          "type": "string",
          "hint": "敏感信息，建议配合密钥托管"
        },
        {
          "key": "cloud.baseUrl",
          "label": "访问域名",
          "type": "string",
          "hint": "CDN / 自定义访问域名，用于拼接产物 URL"
        }
      ]
    }
  ],
  "defaults": {
    "enabled": true,
    "requiredGrant": "",
    "dependsOn": [],
    "render": {
      "strict": true,
      "autoEscape": true
    },
    "export": {
      "defaultStages": [
        "final"
      ],
      "defaultFileName": "edm.html",
      "openAfterGenerate": false
    }
  },
  "package": {
    "schemaVersion": 1,
    "version": "1.0.0",
    "requiresHost": {
      "api": "^1.0",
      "capabilities": []
    },
    "sandbox": "utility",
    "ipcAllowlist": []
  }
}
